# Contact form SMTP settings.
# Copy to .env.local and replace placeholders with environment-specific values.
# Do not commit real SMTP credentials or recipient addresses.

SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@example.com
SMTP_PASSWORD=replace-with-smtp-password
CONTACT_RECIPIENT=owner@example.com

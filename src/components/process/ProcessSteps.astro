---
const steps = [
  {
    number: "01",
    title: "Обсуждение задачи",
    text: "Вы рассказываете о цели, аудитории и том, что уже есть. Вместе уточняем задачу.",
    icon: "search",
  },
  {
    number: "02",
    title: "Согласование объёма",
    text: "Определяем результат, состав работ и порядок дальнейших шагов.",
    icon: "architecture",
  },
  {
    number: "03",
    title: "Разработка и проверка",
    text: "Создаю решение и показываю промежуточный результат для обратной связи.",
    icon: "code",
  },
  {
    number: "04",
    title: "Подготовка запуска",
    text: "Проверяем готовность и согласовываем запуск и дальнейшую поддержку.",
    icon: "launch",
  },
] as const;
---

<section class="process-steps" aria-labelledby="process-steps-title">
  <h2 id="process-steps-title" class="sr-only">Этапы работы</h2>
  {
    steps.map((step) => (
      <article class="step">
        <div class="step-marker" aria-hidden="true">
          <div class="step-num">{step.number}</div>
          <div class="step-line"></div>
        </div>
        <div class="step-icon" aria-hidden="true">
          {
            step.icon === "search" && (
              <svg viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-3.5-3.5"></path>
              </svg>
            )
          }
          {
            step.icon === "architecture" && (
              <svg viewBox="0 0 24 24">
                <path d="M12 2l8.7 5v10L12 22l-8.7-5V7L12 2z"></path>
                <path d="M12 12L3.3 7"></path>
                <path d="M12 12l8.7-5"></path>
                <path d="M12 12v10"></path>
              </svg>
            )
          }
          {
            step.icon === "code" && (
              <svg viewBox="0 0 24 24">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            )
          }
          {
            step.icon === "launch" && (
              <svg viewBox="0 0 24 24">
                <path d="M12 2c-3 4-5 8-5 13v2l2-.5.5 2.5c.5 1.5 1.5 2.5 2.5 2.5s2-1 2.5-2.5l.5-2.5 2 .5v-2c0-5-2-9-5-13z"></path>
                <circle cx="12" cy="10" r="2"></circle>
                <path d="M12 19v3"></path>
              </svg>
            )
          }
        </div>
        <div class="step-body">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </article>
    ))
  }
</section>


---
import PhoneChart from "./PhoneChart.astro";

const flowSteps = [
  ["Бизнес", "цели"],
  ["Анализ", "исследование"],
  ["Проектирование", "архитектуры"],
  ["Разработка"],
  ["Запуск", "поддержка"],
] as const;

const branches = ["Структура", "Компоненты", "Интеграции"] as const;

const chips = [
  { label: "Современные фреймворки", icon: "chip" },
  { label: "Frontend-архитектура", icon: "layout" },
  { label: "Компонентный подход", icon: "cube" },
  { label: "Интеграции API", icon: "code" },
  { label: "Тестирование", icon: "shield" },
  { label: "Производительность", icon: "bolt" },
  { label: "CI/CD", icon: "gauge" },
  { label: "Поддержка и развитие", icon: "clock" },
] as const;
---

<section class="process-diagram" aria-labelledby="process-diagram-title">
  <h2 id="process-diagram-title" class="sr-only">Схема процесса</h2>
  <svg class="diagram-lines" viewBox="0 0 880 720" aria-hidden="true">
    <path d="M440 31 L440 145"></path>
    <path d="M147 145 L733 145"></path>
    <path class="dash" d="M147 145 L147 206"></path>
    <path class="dash" d="M440 145 L440 206"></path>
    <path class="dash" d="M733 145 L733 206"></path>
  </svg>

  <ol class="flowchart" aria-label="Порядок процесса">
    {
      flowSteps.map((step, index) => (
        <>
          <li class="flow-step">
            <span class="flow-box">
              {step[0]}
              {step[1] && (
                <>
                  <br />
                  {step[1]}
                </>
              )}
            </span>
          </li>
          {index < flowSteps.length - 1 && <li class="flow-arrow" aria-hidden="true"></li>}
        </>
      ))
    }
  </ol>

  <ul class="branch-row" aria-label="Основные ветки архитектуры">
    {branches.map((branch) => <li class="branch-box">{branch}</li>)}
  </ul>

  <div class="device-zone" aria-label="Результаты проектирования">
    <figure class="device device-phone">
      <div class="device-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <figcaption class="sr-only">Мобильный экран со списком и графиком</figcaption>
      <div class="device-screen">
        <div class="phone-list" aria-hidden="true">
          <div class="phone-row"></div>
          <div class="phone-row short"></div>
          <div class="phone-row"></div>
          <div class="phone-row short"></div>
        </div>
        <PhoneChart />
      </div>
    </figure>

    <figure class="device device-dash">
      <div class="device-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <figcaption class="sr-only">Дашборд с сайдбаром и линейным графиком</figcaption>
      <div class="device-screen">
        <div class="dash-layout" aria-hidden="true">
          <div class="dash-sidebar"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="dash-main">
            <div class="dash-bar"></div>
            <div class="dash-bar short"></div>
            <div class="dash-chart">
              <svg width="100%" height="100%" viewBox="0 0 240 90" preserveAspectRatio="none">
                <polyline
                  points="0,75 40,55 80,65 120,35 160,45 200,20 240,30"
                  fill="none"
                  stroke="rgba(126, 210, 255, 0.5)"
                  stroke-width="1.5"
                />
                <circle
                  cx="120"
                  cy="35"
                  r="4"
                  fill="none"
                  stroke="rgba(126, 210, 255, 0.7)"
                  stroke-width="1.5"
                />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </figure>

    <figure class="device device-code">
      <div class="device-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <figcaption class="sr-only">Экран с фрагментами кода</figcaption>
      <div class="device-screen">
        <div class="code-lines" aria-hidden="true">
          <div class="code-line"></div>
          <div class="code-line w-80 accent"></div>
          <div class="code-line w-60"></div>
          <div class="code-line w-40"></div>
          <div class="code-line"></div>
          <div class="code-line w-80"></div>
          <div class="code-line w-60 accent"></div>
          <div class="code-line w-40"></div>
          <div class="code-line"></div>
        </div>
      </div>
    </figure>
  </div>

  <ul class="tech-zone" aria-label="Технологические принципы">
    {
      chips.map((chip) => (
        <li class="tech-chip">
          {
            chip.icon === "chip" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                <path d="M9 9h6v6H9z"></path>
                <path d="M9 1v3"></path>
                <path d="M15 1v3"></path>
                <path d="M9 20v3"></path>
                <path d="M15 20v3"></path>
                <path d="M20 9h3"></path>
                <path d="M20 15h3"></path>
                <path d="M1 9h3"></path>
                <path d="M1 15h3"></path>
              </svg>
            )
          }
          {
            chip.icon === "layout" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <path d="M3 9h18"></path>
                <path d="M9 21V9"></path>
              </svg>
            )
          }
          {
            chip.icon === "cube" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2l8.7 5v10L12 22l-8.7-5V7L12 2z"></path>
                <path d="M12 12L3.3 7"></path>
                <path d="M12 12l8.7-5"></path>
              </svg>
            )
          }
          {
            chip.icon === "code" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            )
          }
          {
            chip.icon === "shield" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            )
          }
          {
            chip.icon === "bolt" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
            )
          }
          {
            chip.icon === "gauge" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 12a8 8 0 0 1 16 0"></path>
                <path d="M12 12v8"></path>
                <path d="M12 12l4 4"></path>
                <path d="M12 12l-4 4"></path>
              </svg>
            )
          }
          {
            chip.icon === "clock" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"></path>
                <path d="M12 6v6l4 2"></path>
              </svg>
            )
          }
          <span>{chip.label}</span>
        </li>
      ))
    }
  </ul>
</section>


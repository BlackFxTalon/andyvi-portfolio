---
import type { WorkItem } from "@/utils/works";

interface Props {
  work: WorkItem;
}

const { work } = Astro.props;
const previewClass = `project-preview preview-${work.slug}`;
---

<div class={previewClass} aria-hidden="true">
  <div class="preview-dots"><i></i><i></i><i></i></div>

  {
    work.slug === "autoapp" && (
      <>
        <div class="headline">Запчасти<br />для иномарок</div>
        <div class="wheel"></div>
        <div class="mini-card"></div>
        <div class="mini-card two"></div>
      </>
    )
  }

  {
    work.slug === "erp4seller" && (
      <>
        <div class="side"></div>
        <div class="chart">
          <svg viewBox="0 0 142 104" fill="none" aria-hidden="true" focusable="false">
            <path d="M4 88 22 72 38 76 56 42 72 58 91 24 112 46 138 18" stroke="#4e76ff" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
            <path d="M4 88 22 72 38 76 56 42 72 58 91 24 112 46 138 18" stroke="#78d7ff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" />
          </svg>
        </div>
        <div class="panel"></div>
      </>
    )
  }

  {
    work.slug === "interno" && (
      <>
        <div class="plant"></div>
        <div class="sofa"></div>
      </>
    )
  }

  {
    work.slug === "industrial-configurator" && (
      <>
        <div class="machine"></div>
        <div class="rail"></div>
        <div class="panel"></div>
      </>
    )
  }
</div>

<style>
  .project-preview {
    position: relative;
    min-height: 230px;
    overflow: hidden;
    border: 1px solid rgba(183, 229, 249, 0.14);
    border-radius: var(--radius-control);
    background: rgba(2, 7, 12, 0.72);
    box-shadow: inset 0 0 28px rgba(91, 183, 231, 0.08);
  }

  .project-preview::before {
    position: absolute;
    inset: 0 0 auto;
    height: 30px;
    border-bottom: 1px solid rgba(188, 231, 249, 0.1);
    background: rgba(4, 11, 17, 0.86);
    content: "";
  }

  .preview-dots {
    position: absolute;
    top: 11px;
    right: 12px;
    z-index: 2;
    display: flex;
    gap: 9px;
  }

  .preview-dots i {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-round);
    background: rgba(191, 236, 255, 0.52);
    box-shadow: 0 0 8px rgba(144, 221, 255, 0.36);
  }

  .preview-autoapp {
    background:
      radial-gradient(circle at 48% 62%, rgba(226, 233, 238, 0.14), transparent 27%),
      linear-gradient(135deg, #0b0f14, #01050b 64%);
  }

  .preview-autoapp .wheel {
    position: absolute;
    top: 72px;
    left: 176px;
    width: 112px;
    height: 112px;
    border: 18px solid rgba(227, 235, 239, 0.18);
    border-radius: var(--radius-round);
    box-shadow:
      inset 0 0 0 14px rgba(0, 0, 0, 0.78),
      0 0 32px rgba(190, 226, 245, 0.1);
  }

  .preview-autoapp .headline {
    position: absolute;
    top: 58px;
    left: 32px;
    width: 132px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 22px;
    line-height: 1.05;
  }

  .preview-autoapp .mini-card {
    position: absolute;
    top: 60px;
    right: 24px;
    width: 92px;
    height: 74px;
    border: 1px solid rgba(220, 240, 250, 0.14);
    background: rgba(255, 255, 255, 0.04);
  }

  .preview-autoapp .mini-card.two {
    top: 142px;
  }

  .preview-erp4seller {
    background: linear-gradient(135deg, #07101d, #02050c 70%);
  }

  .preview-erp4seller .side {
    position: absolute;
    top: 44px;
    left: 14px;
    width: 82px;
    height: 166px;
    border: 1px solid rgba(198, 225, 244, 0.1);
    background: rgba(255, 255, 255, 0.025);
  }

  .preview-erp4seller .chart {
    position: absolute;
    top: 64px;
    left: 122px;
    width: 168px;
    height: 124px;
  }

  .preview-erp4seller .panel {
    position: absolute;
    top: 58px;
    right: 26px;
    width: 112px;
    height: 142px;
    border: 1px solid rgba(120, 215, 255, 0.18);
    background:
      linear-gradient(180deg, rgba(120, 215, 255, 0.1), transparent),
      repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 22px);
  }

  .preview-interno {
    background:
      radial-gradient(circle at 72% 58%, rgba(142, 190, 154, 0.12), transparent 28%),
      linear-gradient(135deg, #0a1110, #020608 72%);
  }

  .preview-interno .plant {
    position: absolute;
    top: 64px;
    left: 68px;
    width: 74px;
    height: 126px;
    border-bottom: 46px solid rgba(196, 155, 112, 0.34);
    border-left: 22px solid transparent;
    border-right: 22px solid transparent;
  }

  .preview-interno .plant::before {
    position: absolute;
    top: -22px;
    left: -28px;
    width: 94px;
    height: 82px;
    border-radius: 70% 40% 70% 45%;
    background: rgba(78, 170, 120, 0.34);
    box-shadow: 26px 18px 0 rgba(82, 188, 130, 0.22);
    content: "";
    transform: rotate(-12deg);
  }

  .preview-interno .sofa {
    position: absolute;
    right: 42px;
    bottom: 38px;
    width: 230px;
    height: 86px;
    border-radius: 26px 26px 14px 14px;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 33%),
      rgba(194, 201, 190, 0.16);
    box-shadow: 0 18px 0 -8px rgba(141, 118, 94, 0.22);
  }

  .preview-industrial-configurator {
    background:
      radial-gradient(circle at 58% 50%, rgba(137, 210, 245, 0.1), transparent 28%),
      linear-gradient(135deg, #090d12, #02050a 70%);
  }

  .preview-industrial-configurator .machine {
    position: absolute;
    top: 62px;
    left: 64px;
    width: 180px;
    height: 112px;
    border: 1px solid rgba(210, 236, 248, 0.18);
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08), transparent 34%),
      rgba(116, 139, 152, 0.14);
    transform: skewX(-8deg);
  }

  .preview-industrial-configurator .rail {
    position: absolute;
    right: 52px;
    bottom: 52px;
    width: 300px;
    height: 2px;
    background: rgba(190, 230, 250, 0.24);
    box-shadow:
      0 -32px 0 rgba(190, 230, 250, 0.08),
      0 32px 0 rgba(190, 230, 250, 0.08);
  }

  .preview-industrial-configurator .panel {
    position: absolute;
    top: 58px;
    right: 34px;
    width: 128px;
    height: 118px;
    border: 1px solid rgba(145, 236, 255, 0.22);
    background:
      radial-gradient(circle at 32% 34%, rgba(145, 236, 255, 0.28), transparent 10%),
      linear-gradient(180deg, rgba(145, 236, 255, 0.08), rgba(255, 86, 123, 0.05));
  }

  @media (width < 820px) {
    .project-preview {
      min-height: 210px;
    }
  }
</style>

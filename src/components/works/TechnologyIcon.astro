---
import type { TechnologyDefinition } from "@/data/technologies";

interface Props {
  technology: TechnologyDefinition;
  class?: string;
}

const { technology, class: className = "tech-icon" } = Astro.props;
---

{
  technology.key === "Vue" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-tech-icon={technology.key}>
      <path d="M12 22 2 4h4.5L12 14.5 17.5 4H22L12 22Z" fill="#41b883" />
      <path d="M12 17 7.25 6.5h9.5L12 17Z" fill="#35495e" />
    </svg>
  )
}
{
  technology.key === "Nuxt" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-tech-icon={technology.key}>
      <path d="M2 19 8.5 8 12 14l3.5-5.5L22 19H2Z" fill="#00dc82" />
    </svg>
  )
}
{
  technology.key === "TypeScript" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-tech-icon={technology.key}>
      <rect x="1.5" y="1.5" width="21" height="21" rx="2.5" fill="#3178c6" />
      <path
        d="M8.5 8.5h5M11 8.5v8M14 12.5c1.5 0 2.5 1 2.5 2.5s-1 2.5-2.5 2.5"
        fill="none"
        stroke="#fff"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
      />
    </svg>
  )
}
{
  technology.key === "Pinia" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-tech-icon={technology.key}>
      <ellipse cx="12" cy="14.5" rx="7.5" ry="9" fill="#f7d336" />
      <ellipse cx="12" cy="14.5" rx="5.2" ry="6.4" fill="#eaad3e" />
      <path d="M9 5.5c0-1.7 1.1-3.3 3-3.3s3 1.6 3 3.3" fill="none" stroke="#8b5a2b" stroke-linecap="round" stroke-width="1.4" />
      <path d="M9 11h6M9 15h6M10.5 19h3" stroke="#8b5a2b" stroke-linecap="round" stroke-width="1" />
    </svg>
  )
}
{
  technology.key === "Chart.js" && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-tech-icon={technology.key}>
      <path d="M4 20v-6" stroke="#ff6384" stroke-linecap="round" stroke-width="2.5" />
      <path d="M9 20V10" stroke="#36a2eb" stroke-linecap="round" stroke-width="2.5" />
      <path d="M14 20v-7" stroke="#ffce56" stroke-linecap="round" stroke-width="2.5" />
      <path d="M19 20V7" stroke="#4bc0c0" stroke-linecap="round" stroke-width="2.5" />
    </svg>
  )
}

<style>
  svg {
    display: block;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
  }
</style>

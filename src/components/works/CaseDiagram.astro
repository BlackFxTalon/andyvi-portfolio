---
import type { WorkItem } from "@/utils/works";

interface Props {
  work: WorkItem;
}

const { work } = Astro.props;
---

<div class="case-diagram" role="img" aria-label={`Схема проекта ${work.title}`}>
  <span class="case-diagram__label">Схема проекта</span>
  <strong>{work.title}</strong>
  <span class="case-diagram__type">{work.type}</span>
  <div class="case-diagram__nodes" aria-hidden="true">
    <span>Интерфейс</span><span>›</span><span>Данные</span><span>›</span><span>Результат</span>
  </div>
</div>

<style>
  .case-diagram {
    display: grid;
    align-content: center;
    gap: 12px;
    min-width: 0;
    min-height: 210px;
    padding: clamp(20px, 4vw, 36px);
    border: 1px solid rgba(183, 229, 249, 0.2);
    background: radial-gradient(circle at 70% 20%, rgba(92, 189, 226, 0.16), transparent 50%), #06111a;
  }

  .case-diagram__label, .case-diagram__type {
    color: #bdcbd4;
    font-size: 14px;
  }

  strong {
    color: #f4f8ff;
    font-size: clamp(20px, 3vw, 30px);
    overflow-wrap: anywhere;
  }

  .case-diagram__nodes {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: #dcecf4;
    font-size: 13px;
  }

  .case-diagram__nodes span:nth-child(odd) {
    padding: 6px 8px;
    border: 1px solid rgba(183, 229, 249, 0.25);
  }
</style>

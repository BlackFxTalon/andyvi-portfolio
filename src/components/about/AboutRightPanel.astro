---
import { Image } from "astro:assets";
import portrait from "@/assets/images/andyvi-bg-shadow-silhouette-smoke-sharp-v2.png";

const techChips = [
  { label: "Vue 3", symbol: "icon-about-vue" },
  { label: "Nuxt", symbol: "icon-about-nuxt" },
  { label: "TypeScript", symbol: "icon-about-ts" },
  { label: "Pinia", symbol: "icon-about-pinia" },
  { label: "Vitest", symbol: "icon-about-vitest" },
  { label: "Cypress", symbol: "icon-about-cypress" },
  { label: "GitLab CI/CD", symbol: "icon-about-gitlab" },
  { label: "Docker", symbol: "icon-about-docker" },
  { label: "REST API", symbol: "icon-about-rest" },
] as const;

const timeline = [
  {
    years: "Январь 2024 — настоящее время",
    title: "AUTOAPP",
    role: "Frontend-разработчик",
    detail:
      "Frontend-разработка с Vue, Nuxt и TypeScript.",
  },
  {
    years: "Март 2022 — январь 2024",
    title: "Legacy Agency / Enterplan",
    role: "Frontend-разработчик",
    detail:
      "Frontend-разработка с Vue.",
  },
  {
    years: "Период уточняется",
    title: "Уралредуктор",
    role: "Роль уточняется",
    detail:
      "Проект для промышленного предприятия; детали и личный вклад уточняются.",
  },
] as const;
---

<section class="about-hero" id="about" aria-label="Кто я">
  <p class="eyebrow">Кто я</p>
  <div class="title-row">
    <h1 class="about-title">
      <span class="about-title-word">Обо мне</span>
    </h1>
    <div class="title-rule" aria-hidden="true"></div>
  </div>
  <div class="bio-intro">
    <Image class="portrait" src={portrait} alt="Андрей Воронцов" widths={[320, 640]} sizes="(max-width: 620px) 100vw, 260px" />
    <div>
      <p class="bio-name">Андрей Воронцов</p>
      <p class="bio">
        Frontend-разработчик. Специализируюсь на Vue 3, Nuxt,
        TypeScript, архитектуре фронтенда, оптимизации производительности и CI/CD.
        Разрабатываю сервисы для e-commerce, ERP/CRM и промышленных решений.
      </p>
    </div>
  </div>

  <h2 class="section-label">Ключевые компетенции</h2>
  <ul class="skill-grid" aria-label="Ключевые компетенции">
    {
      techChips.map((chip) => (
        <li class="skill-chip">
          <svg class="skill-icon" aria-hidden="true" focusable="false">
            <use href={`#${chip.symbol}`}></use>
          </svg>
          <span>{chip.label}</span>
        </li>
      ))
    }
  </ul>

  <h2 class="section-label">Опыт работы</h2>
  <ol class="timeline" aria-label="Опыт работы">
    {
      timeline.map((item) => (
        <li class="timeline-card">
          <time class="timeline-years">{item.years}</time>
          <span class="timeline-body">
            <span class="timeline-title">{item.title}</span>
            <span class="timeline-role">{item.role}</span>
            <span class="timeline-detail">{item.detail}</span>
          </span>
        </li>
      ))
    }
  </ol>
  <p class="about-contact"><a href="/contacts">Обсудить задачу</a></p>
</section>

<svg class="about-tech-symbols" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="icon-about-vue" viewBox="0 0 24 24">
      <path d="M12 22L2 4h4.5L12 14.5 17.5 4H22L12 22z" fill="#41B883"></path>
      <path d="M12 17L7.25 6.5h9.5L12 17z" fill="#35495E"></path>
    </symbol>
    <symbol id="icon-about-nuxt" viewBox="0 0 24 24">
      <path d="M2 19l6.5-11 3.5 6 3.5-5.5L22 19H2z" fill="#00DC82"></path>
    </symbol>
    <symbol id="icon-about-ts" viewBox="0 0 24 24">
      <rect x="1.5" y="1.5" width="21" height="21" rx="2.5" fill="#3178C6"></rect>
      <path
        d="M8.5 8.5h5M11 8.5v8M14 12.5c1.5 0 2.5 1 2.5 2.5s-1 2.5-2.5 2.5"
        stroke="#fff"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </symbol>
    <symbol id="icon-about-pinia" viewBox="0 0 24 24">
      <ellipse cx="12" cy="14.5" rx="7.5" ry="9" fill="#F7D336"></ellipse>
      <ellipse cx="12" cy="14.5" rx="5.2" ry="6.4" fill="#EAAD3E"></ellipse>
      <path
        d="M9 11h6M9 15h6M10.5 19h3"
        stroke="#8B5A2B"
        stroke-width="1"
        stroke-linecap="round"></path>
    </symbol>
    <symbol id="icon-about-vitest" viewBox="0 0 24 24">
      <path d="M12 2L2 20h20L12 2z" fill="#F7D336"></path>
      <path d="M12 7L6.5 18h11L12 7z" fill="#729B1B"></path>
      <path d="M12 11l-2.5 5h5L12 11z" fill="#B9E248"></path>
    </symbol>
    <symbol id="icon-about-cypress" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10" fill="#69D3A7"></circle>
      <path
        d="M7.5 12.5c0-2 1.5-3.5 3.5-3.5 1.6 0 2.9.9 3.4 2.2l1.8-.8C15.3 8.2 13.8 7 11 7c-3.3 0-5.5 2.3-5.5 5.5s2.2 5.5 5.5 5.5c2.8 0 4.3-1.2 5.2-3.4l-1.8-.8c-.5 1.3-1.8 2.2-3.4 2.2-2 0-3.5-1.5-3.5-3.5z"
        fill="#1E1E1E"></path>
    </symbol>
    <symbol id="icon-about-gitlab" viewBox="0 0 24 24">
      <path d="M12 21.5L15.5 10H8.5L12 21.5z" fill="#FC6D26"></path>
      <path d="M12 21.5L8.5 10H3.5L12 21.5z" fill="#E24329"></path>
      <path d="M3.5 10L2 14.5c-.2.5.1 1 .5 1.2L12 21.5 3.5 10z" fill="#FCA326"></path>
      <path d="M3.5 10h5L6 4c-.2-.5-.7-.5-.9 0L3.5 10z" fill="#E24329"></path>
      <path d="M12 21.5l9.5-6.8c.4-.2.7-.7.5-1.2L20.5 10 12 21.5z" fill="#FCA326"></path>
      <path d="M20.5 10h-5l2.5-6c.2-.5.7-.5.9 0l1.6 6z" fill="#FC6D26"></path>
    </symbol>
    <symbol id="icon-about-docker" viewBox="0 0 24 24">
      <path
        d="M21 12.5c-.5 0-1-.1-1.4-.3.2-.6.3-1.2.3-1.8 0-2.5-2-4.5-4.5-4.5H2v9c0 2.8 2.2 5 5 5h12c2.5 0 4.5-2 4.5-4.5 0-.4-.1-.7-.2-1.1-.8.4-1.7.7-2.3.7zM5 13.5H4v-2h1v2zm3 0H7v-2h1v2zm3 0h-1v-2h1v2zm3 0h-1v-2h1v2zm-9-3H4v-2h1v2zm3 0H7v-2h1v2zm3 0h-1v-2h1v2zm3 0h-1v-2h1v2zm3 0h-1v-2h1v2z"
        fill="#2496ED"></path>
    </symbol>
    <symbol id="icon-about-rest" viewBox="0 0 24 24">
      <path
        d="M4 8h16M4 12h16M4 16h16"
        stroke="#4FC3F7"
        stroke-width="2"
        stroke-linecap="round"></path>
      <circle cx="8" cy="8" r="1.5" fill="#4FC3F7"></circle>
      <circle cx="14" cy="12" r="1.5" fill="#4FC3F7"></circle>
      <circle cx="10" cy="16" r="1.5" fill="#4FC3F7"></circle>
    </symbol>
  </defs>
</svg>

<style>
  .bio-intro {
    display: grid;
    grid-template-columns: minmax(160px, 240px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    margin-block-end: 34px;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    border: 1px solid rgba(183, 229, 249, 0.24);
  }

  .bio-name {
    margin-bottom: 12px;
    color: var(--cold-white);
    font-size: 22px;
    font-weight: 600;
  }

  .bio-intro .bio {
    margin: 0;
    font-size: 18px;
  }

  @media (width < 620px) {
    .bio-intro { grid-template-columns: 1fr; }
    .portrait { max-width: 280px; }
  }

  .about-contact {
    margin-block-start: 24px;
  }

  .about-contact a {
    display: inline-block;
    padding-block: 12px;
    color: var(--cold-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-hero {
    position: absolute;
    inset-block-start: 142px;
    inset-inline-start: 895px;
    z-index: var(--z-content);
    width: 740px;
  }

  .eyebrow {
    margin-block-end: 22px;
    color: var(--cold-white);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-wider);
    line-height: var(--line-none);
    text-transform: uppercase;
    text-shadow: 0 0 12px rgba(189, 232, 255, 0.25);
  }

  .title-row {
    display: grid;
    grid-template-columns: auto minmax(160px, 1fr);
    align-items: center;
    gap: 34px;
    margin-block-end: 21px;
  }

  .about-title {
    color: var(--cold-white);
    font-family: var(--font-heading);
    font-size: 94px;
    font-weight: 800;
    letter-spacing: 0.018em;
    line-height: var(--line-display);
    text-shadow:
      0 0 2px rgba(255, 255, 255, 0.9),
      0 0 16px rgba(168, 223, 255, 0.3),
      0 0 34px rgba(97, 177, 230, 0.18);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .about-title-word {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .title-rule {
    min-width: 160px;
    height: var(--border-width-hairline);
    background: linear-gradient(
      90deg,
      rgba(222, 243, 255, 0.46),
      rgba(222, 243, 255, 0.14) 62%,
      transparent
    );
    box-shadow: 0 0 12px rgba(177, 229, 255, 0.22);
  }

  .bio {
    max-width: 688px;
    margin-block-end: 34px;
    color: #d8dde3;
    font-size: 27px;
    font-weight: 300;
    line-height: var(--line-copy);
    text-shadow: 0 0 14px rgba(165, 215, 240, 0.12);
  }

  .section-label {
    margin-block-end: 18px;
    color: rgba(244, 248, 255, 0.48);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-wider);
    line-height: var(--line-none);
    text-transform: uppercase;
  }

  .skill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    max-width: 690px;
    margin-block-end: 32px;
  }

  .skill-chip {
    display: inline-flex;
    min-width: 112px;
    max-width: none;
    height: 42px;
    align-items: center;
    gap: 10px;
    padding-inline: 18px;
    border: var(--border-width-hairline) solid rgba(176, 229, 255, 0.28);
    border-radius: var(--radius-control-lg);
    background: linear-gradient(
      180deg,
      rgba(12, 28, 38, 0.44),
      rgba(2, 7, 13, 0.22)
    );
    color: rgba(245, 250, 255, 0.9);
    font-size: 18px;
    font-weight: 300;
    line-height: var(--line-none);
    text-align: left;
    transition:
      transform var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .skill-chip:hover,
  .skill-chip:focus-within {
    border-color: rgba(216, 247, 255, 0.54);
    color: #fff;
    box-shadow:
      inset 0 0 16px rgba(131, 213, 255, 0.11),
      0 0 18px rgba(104, 204, 255, 0.13);
    transform: translateY(-1px);
  }

  .skill-icon {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }

  .timeline {
    position: relative;
    display: grid;
    max-width: 720px;
    gap: 13px;
    padding-inline-start: 34px;
  }

  .timeline::before {
    position: absolute;
    inset-block: 12px 14px;
    inset-inline-start: 7px;
    width: var(--border-width-hairline);
    background: linear-gradient(
      180deg,
      rgba(231, 250, 255, 0.74),
      rgba(231, 250, 255, 0.26)
    );
    box-shadow: 0 0 13px rgba(180, 231, 255, 0.28);
    content: "";
  }

  .timeline-card {
    position: relative;
    display: grid;
    max-width: none;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 18px;
    width: 100%;
    color: inherit;
    text-align: left;
  }

  .timeline-card::before {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-start: -33px;
    width: 13px;
    height: 13px;
    border: 2px solid rgba(234, 250, 255, 0.78);
    border-radius: var(--radius-round);
    background: var(--deep);
    box-shadow: 0 0 11px rgba(184, 232, 255, 0.3);
    content: "";
  }

  .timeline-years {
    color: rgba(219, 231, 238, 0.76);
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.3;
  }

  .timeline-title {
    display: block;
    margin-block-end: 3px;
    color: var(--cold-white);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-ui);
    line-height: var(--line-compact);
  }

  .timeline-role {
    display: block;
    margin-block-end: 5px;
    color: rgba(238, 247, 252, 0.88);
    font-size: 15px;
    line-height: 1.25;
  }

  .timeline-detail {
    display: block;
    color: rgba(213, 225, 233, 0.74);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.35;
  }

  .about-tech-symbols {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  @media (width >= 0px) {
    .about-hero {
      position: relative;
      inset: auto;
      width: 100%;
      max-width: 760px;
      order: -1;
    }

    .title-row {
      grid-template-columns: minmax(0, auto) minmax(80px, 1fr);
      gap: clamp(16px, 4vw, 34px);
    }

    .about-title {
      font-size: clamp(52px, 11vw, 94px);
      white-space: normal;
    }

    .bio {
      max-width: 100%;
      font-size: clamp(18px, 3.8vw, 25px);
    }
  }

  @media (width < 620px) {
    .eyebrow,
    .section-label {
      font-size: 15px;
      letter-spacing: var(--letter-wide);
    }

    .title-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .about-title {
      font-size: clamp(42px, 13vw, 58px);
    }

    .title-rule {
      width: 100%;
      min-width: 0;
    }

    .skill-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .skill-chip {
      min-width: 0;
      width: 100%;
      padding-inline: 12px;
      font-size: 15px;
    }

    .timeline-card {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .timeline-years {
      font-size: 16px;
    }

    .timeline-title {
      font-size: 21px;
      overflow-wrap: anywhere;
    }
  }

  @media (width < 380px) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-chip:hover,
    .skill-chip:focus-within {
      transform: none;
    }
  }
</style>

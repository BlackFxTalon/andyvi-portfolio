---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HudDecor from "@/components/hud/HudDecor.astro";
---

<BaseLayout
  title="Андрей Воронцов — сайты, веб-приложения и автоматизация"
  description="Разработка интерфейсов, веб-приложений и автоматизаций: Vue, Nuxt, API и n8n."
  currentPage="home"
  canonicalPath="/"
>
  <div class="home">
    <div class="ambient" aria-hidden="true"></div>
    <HudDecor />
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">Андрей Воронцов · разработчик</p>
        <h1 id="home-title">Сайты, веб-приложения и автоматизация для бизнеса</h1>
        <p class="lead">Разрабатываю интерфейсы, работаю с API и автоматизацией на n8n. В портфолио — интернет-магазины, ERP, боты и интеграции.</p>
        <div class="actions">
          <a class="button button-primary" href="/contacts">Обсудить задачу <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/works" id="projectsCta">Посмотреть проекты <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="workflow">
        <figcaption>Схема автоматизации</figcaption>
        <p class="workflow-title">Авито → бот → Telegram</p>
        <ol aria-label="Тестовая цепочка обработки обращения">
          <li><span>01</span> Обращение в Авито</li>
          <li><span>02</span> Ответ бота</li>
          <li><span>03</span> Уведомление в Telegram</li>
        </ol>
        <p class="workflow-note">Тестовая цепочка внутреннего приложения AI Avito Admin.</p>
      </figure>
    </section>

    <section class="content-section" aria-labelledby="services-title">
      <p class="section-kicker">Чем могу помочь</p>
      <h2 id="services-title">От интерфейса до интеграции</h2>
      <div class="cards">
        <article><h3>Сайты</h3><p>Лендинги и интернет-магазины с понятной структурой и адаптацией под устройства.</p></article>
        <article><h3>Веб-приложения</h3><p>Личные кабинеты, административные интерфейсы и системы для работы с данными.</p></article>
        <article><h3>Автоматизация</h3><p>Интеграции с API, боты и рабочие процессы на n8n.</p></article>
      </div>
    </section>

    <section class="content-section" aria-labelledby="featured-title">
      <p class="section-kicker">Портфолио</p>
      <h2 id="featured-title">Избранные работы</h2>
      <div class="cards">
        <article><p class="card-kind">Автоматизация</p><h3><a href="/works/ai-avito-admin">AI Avito Admin →</a></h3><p>Внутреннее приложение для работы с ботами и обращениями Авито.</p></article>
        <article><p class="card-kind">ERP</p><h3><a href="/works/erp4seller">ERP4Seller →</a></h3><p>Система для управления бизнесом на маркетплейсах.</p></article>
        <article><p class="card-kind">Интернет-магазин</p><h3><a href="/works/interno">Интерно →</a></h3><p>Проект мебельного магазина из портфолио.</p></article>
      </div>
      <a class="text-link" href="/works">Все проекты →</a>
    </section>

    <section class="content-section closing" aria-labelledby="process-title">
      <div><p class="section-kicker">Как работаю</p><h2 id="process-title">От обсуждения до запуска</h2><p>Обсудим задачу, согласуем объём, проверим промежуточный результат и подготовим запуск.</p></div>
      <div class="closing-links"><a class="text-link" href="/process">Подробнее о процессе →</a><a class="button button-primary" href="/contacts">Связаться со мной ↗</a></div>
    </section>
  </div>
</BaseLayout>

<style>
  .home { position: relative; display: grid; gap: clamp(72px, 9vw, 140px); padding: clamp(48px, 7vw, 100px) 0 100px; }
  .ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0, 5, 10, .12), rgba(0, 5, 10, .32)), url("/smoke-tech-v1.png") center top / cover no-repeat; }
  .hero, .content-section { position: relative; z-index: 2; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); align-items: center; gap: clamp(28px, 5vw, 88px); min-height: 560px; }
  .eyebrow, .section-kicker, .card-kind, figcaption { color: #9ec6d9; font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 850px; margin: 20px 0 24px; color: #f4f8ff; font-size: clamp(40px, 5.4vw, 76px); line-height: 1.07; }
  .lead, .closing p { max-width: 650px; color: #d0dce3; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.6; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .button { display: inline-flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 24px; padding: 12px 20px; border: 1px solid #6ca8c2; color: #f4faff; font-weight: 600; }
  .button-primary { background: #163d51; }
  .button-secondary { background: #081721; }
  .button:hover, .button:focus-visible { background: #20566e; }
  .workflow { position: relative; min-width: 0; margin: 0; padding: clamp(24px, 3vw, 40px); border: 1px solid #578299; background: linear-gradient(145deg, rgba(13, 38, 51, .86), rgba(6, 16, 25, .91) 75%); box-shadow: inset 0 0 36px rgba(91, 183, 231, .06), 0 0 32px rgba(91, 183, 231, .08); clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px); }
  .workflow::before { position: absolute; inset: 9px; border: 1px solid rgba(161, 218, 242, .12); pointer-events: none; content: ""; }
  .workflow-title { margin: 16px 0 22px; color: #f4f8ff; font-family: var(--font-heading); font-size: clamp(21px, 2vw, 28px); line-height: 1.25; }
  .workflow ol { display: grid; gap: 10px; padding: 0; margin: 0; list-style: none; }
  .workflow li { max-width: none; padding: 13px; border: 1px solid #31576a; color: #e1eef4; }
  .workflow li span { margin-right: 12px; color: #8dbdd1; font-size: 13px; }
  .workflow-note { margin-top: 18px; color: #b2c7d2; font-size: 14px; }
  h2 { margin: 12px 0 28px; font-size: clamp(30px, 3vw, 46px); line-height: 1.15; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cards article { position: relative; min-width: 0; padding: 25px; border: 1px solid #3b677d; background: linear-gradient(135deg, rgba(15, 39, 51, .88), rgba(4, 15, 23, .92)); clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px); }
  .cards article::before { position: absolute; top: 0; right: 22px; width: 56px; height: 1px; background: #a6e8ff; box-shadow: 0 0 12px #7ad5ff; content: ""; }
  h3 { margin: 0 0 12px; color: #f4f8ff; font-size: 22px; }
  h3 a { text-decoration: underline; text-decoration-color: #6ca8c2; text-underline-offset: 4px; }
  .cards p:not(.card-kind) { color: #cad7df; font-size: 16px; }
  .card-kind { margin-bottom: 12px; }
  .text-link { display: inline-block; padding: 14px 0; color: #c2eaff; text-decoration: underline; text-underline-offset: 5px; }
  .content-section > .text-link { margin-top: 16px; }
  .closing { display: flex; align-items: end; justify-content: space-between; gap: 28px; padding: clamp(24px, 4vw, 48px); border: 1px solid #467389; background: rgba(8, 25, 35, .9); }
  .closing h2 { margin-bottom: 14px; }
  .closing-links { display: grid; flex: 0 0 auto; gap: 8px; }
  @media (width < 820px) {
    .ambient { background-position: 18% top; }
    .home { gap: 72px; padding-top: 46px; }
    .hero { grid-template-columns: 1fr; min-height: 0; gap: 36px; }
    h1 { margin: 15px 0 18px; font-size: clamp(34px, 9vw, 50px); }
    .lead { font-size: 17px; line-height: 1.5; }
    .actions { margin-top: 24px; }
    .cards { grid-template-columns: 1fr; }
    .closing { align-items: stretch; flex-direction: column; }
  }
  @media (width < 430px) {
    .button { width: 100%; }
    .actions { gap: 10px; }
  }
</style>

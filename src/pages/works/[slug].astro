---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cases } from "@/data/cases";

export function getStaticPaths() {
  return cases.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} — Андрей Воронцов`}
  description={project.context}
  currentPage="works"
  canonicalPath={`/works/${project.slug}`}
>
  <article class="case-page">
    <a class="back" href="/works">← Все проекты</a>
    <p class="eyebrow">{project.kind}</p>
    <h1>{project.title}</h1>
    <p class="intro">{project.context}</p>
    <div class="layout">
      <div class="copy">
        <section><h2>Контекст</h2><p>{project.context}</p></section>
        <section><h2>О проекте</h2><p>{project.scope}</p></section>
        <section><h2>Личный вклад</h2><p>Личный вклад уточняется.</p></section>
        <section><h2>Результат и ограничения</h2><p>{project.outcome}</p><p>{project.access}</p></section>
      </div>
      <figure class="diagram">
        <figcaption>Схема проекта</figcaption>
        <p>Иллюстрация основных понятий, не скриншот продукта.</p>
        <ul>{project.diagram.map((item) => <li>{item}</li>)}</ul>
      </figure>
    </div>
    <a class="contact" href="/contacts">Обсудить похожую задачу</a>
  </article>
</BaseLayout>

<style>
  .case-page { width: min(100%, 1120px); margin: 0 auto; padding: 48px 0 100px; }
  .back, .eyebrow, figcaption { color: #a9d2e4; }
  .back { display: inline-block; padding: 12px 0; text-decoration: underline; text-underline-offset: 5px; }
  .eyebrow, figcaption { margin-top: 36px; font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 12px 0 18px; color: #f4f8ff; font-size: clamp(36px, 5vw, 64px); overflow-wrap: anywhere; }
  .intro { max-width: 760px; color: #d0dce3; font-size: 20px; line-height: 1.5; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .7fr); gap: 50px; align-items: start; margin-top: 50px; }
  .copy { display: grid; gap: 30px; }
  h2 { margin: 0 0 10px; color: #f4f8ff; font-size: 24px; }
  .copy p, .diagram p { color: #cad7df; font-size: 17px; line-height: 1.6; }
  .copy p + p { margin-top: 10px; }
  .diagram { margin: 0; padding: 26px; border: 1px solid #34566a; background: #0b1c27; }
  .diagram figcaption { margin: 0 0 12px; }
  .diagram p { font-size: 14px; }
  .diagram ul { display: grid; gap: 10px; padding: 0; margin: 20px 0 0; list-style: none; }
  .diagram li { max-width: none; padding: 14px; border: 1px solid #34566a; color: #e1eef4; }
  .contact { display: inline-flex; min-height: 52px; align-items: center; margin-top: 45px; padding: 12px 20px; border: 1px solid #6ca8c2; background: #163d51; color: #f4faff; font-weight: 600; }
  .contact:hover, .contact:focus-visible { background: #20566e; }
  @media (width < 820px) { .case-page { padding-top: 30px; } .layout { grid-template-columns: 1fr; gap: 32px; } }
</style>

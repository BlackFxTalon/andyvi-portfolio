---
import { ClientRouter } from "astro:transitions";
import MobileNav from "@/components/nav/MobileNav.astro";
import TopBar from "@/components/nav/TopBar.astro";
import { normalizePath, pageFromPath, type PageId } from "@/components/nav/navItems";
import "@/styles/tokens.css";
import "@/styles/global.css";
import "@/styles/animations.css";
import "@/styles/transitions.css";

interface Props {
  title?: string;
  description?: string;
  currentPage?: PageId;
  canonicalPath?: string;
  ogImage?: string;
  class?: string;
}

const defaultTitle = "AndyVi — frontend portfolio";
const defaultDescription = "Портфолио фронтенд-разработчика AndyVi";
const currentPath = normalizePath(Astro.url.pathname);
const {
  title = defaultTitle,
  description = defaultDescription,
  currentPage = pageFromPath(currentPath),
  canonicalPath = currentPath,
  ogImage = "/og-image.png",
  class: className,
  ...rest
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#010308" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AndyVi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogImageUrl.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Tektur:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body data-page={currentPage}>
    <div class="container">
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
      <TopBar currentPage={currentPage} currentPath={currentPath} />
      <MobileNav currentPage={currentPage} currentPath={currentPath} />
      <main 
      id="main-content"
      class:list={['site-main', className]}  
      {...rest}
      tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      import { bindShellLifecycle } from "@/scripts/pageTransition";

      bindShellLifecycle();
    </script>
  </body>
</html>

<style>
  .site-main {
    position: relative;
    z-index: var(--z-content);
    margin-top: 20px;
  }
</style>
